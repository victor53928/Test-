# DART Open API key - free, register at https://opendart.fss.or.kr
DART_API_KEY=

# SQLite DB path (default is fine for local use)
DB_PATH=data/portfolio.db

# Static USD->KRW / JPY->KRW rates for combining KR/US/JP holdings into one
# portfolio total (JPY_KRW_RATE is per 1 JPY, not per 100 JPY).
# Update these periodically to roughly match the actual exchange rate.
USD_KRW_RATE=1400
JPY_KRW_RATE=9.3

# Naver Search API (news) - free, register at https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
