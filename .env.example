# DART Open API key - free, register at https://opendart.fss.or.kr
DART_API_KEY=

# SQLite DB path (default is fine for local use)
DB_PATH=data/portfolio.db

# Static USD->KRW rate for combining KR/US holdings into one portfolio total.
# Update this periodically to roughly match the actual exchange rate.
USD_KRW_RATE=1400

# Naver Search API (news) - free, register at https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
